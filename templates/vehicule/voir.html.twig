{% extends 'base.html.twig' %}
 
{% block main %}
    <section>
 
    <h2>Véhicule : {{vehicule.VeMarque}}, {{vehicule.VeModele}}</h2>


    <h3 id="title">
        Liste des équipements &nbsp;
        <a href="/vehicule/{{ vehicule.VeId }}/ajouter_equipement">[+] Ajouter</a>
    <h3>
    

    {% if equipements is empty %}
 
        <p>Aucun équipement trouvé.</p>
 
    {% else %}
 
    <table class="table">
        <tr>
            <th style="width: 50px">Id</th>
            <th style="width: 150px">Libellé</th>
            <th style="width: 150px">Prix</th>
            <th style="width: 50px">Suppr.</th>
            <th style="width: 50px">Mod.</th>
           
        </tr>
        {% for e in equipements %}
            <tr>
                <td class="center">{{ e.EqId }}</td>
                <td> {{ e.EqLibelle }}</td>
                <td> {{ e.EqPrix }} €</td>

                <td class="center">
                    <a href="/equipement/supprimer/{{ e.EqId }}">
                        <i class="fa-solid fa-trash-can"></i>
                    </a>
                </td>
                <td class="center">
                    <a href="/equipement/modifier/{{ e.EqId }}">
                        <i class="fa-solid fa-pen-to-square"></i>
                    </a>
                </td>
               
            </tr>
        {% endfor %}
    </table>
 
    {% endif %}

    </section>
{% endblock %}