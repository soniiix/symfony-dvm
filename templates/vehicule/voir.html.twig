{% extends 'base.html.twig' %}
 
{% block main %}
    <section>
 
    <h2>Véhicule : {{vehicule.VeMarque}}, {{vehicule.VeModele}}</h2>


    <h3 id="title">
        Liste des équipements &nbsp;
    </h3>

    <div class="actionButtons">
        <a href="/vehicule/{{ vehicule.VeId }}/ajouter_equipement">Ajouter &nbsp;<i class="fa-solid fa-square-plus"></i></a>
    </div>
    

    {% if equipements is empty %}
 
        <p>Aucun équipement trouvé.</p>
 
    {% else %}
 
    <table class="table">
        <tr>
            <th style="width: 50px">Id</th>
            <th style="width: 150px">Libellé</th>
            <th style="width: 150px">Prix</th>
            <th style="width: 150px">Quantité</th>
            <th style="width: 50px">Supprimer</th>
            <th style="width: 50px">Modifier</th>
           
        </tr>
        {% for e in equipements %}
            <tr>
                <td class="center">{{ e.equipement.EqId }}</td>
                <td> {{ e.equipement.EqLibelle }}</td>
                <td> {{ e.equipement.EqPrix }} €</td>
                <td> {{ e.quantite }}</td>

                <td class="center">
                    <a href="/equipement/supprimer/{{ e.equipement.EqId}}">
                        <i class="fa-solid fa-trash-can"></i>
                    </a>
                </td>
                <td class="center">
                    <a href="/vehicule/{{ vehicule.VeId }}/modifier_equipement/{{ e.equipement.EqId }}">
                        <i class="fa-solid fa-pen-to-square"></i>
                    </a>
                </td>
               
            </tr>
        {% endfor %}
    </table>
 
    {% endif %}

    </section>
{% endblock %}