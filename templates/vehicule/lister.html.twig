{% extends 'base.html.twig' %}
 
{% block main %}
    <section>
 
    <h2>Véhicules</h2>

    <div class="actionButtons">
        <a href="/vehicule/ajouter">Ajouter &nbsp;<i class="fa-solid fa-square-plus"></i></a>
        <a href="/vehicule/supprimer_tout">Tout Supprimer &nbsp;<i class="fa-solid fa-square-xmark"></i></a>
    </div>
 
    {% if liste_vehicules is empty %}
 
        <p>Aucun véhicule trouvé.</p>
 
    {% else %}
 
    <table class="table">
        <tr>
            <th style="width: 50px">Id</th>
            <th style="width: 150px">Marque</th>
            <th style="width: 150px">Modèle</th>
            <th style="width: 150px">Conducteur</th>
            <th style="width: 50px">Suppr.</th>
            <th style="width: 50px">Mod.</th>
           
        </tr>
        {% for e in liste_vehicules %}
            <tr>
               
                <td class="center">{{ e.VeId }}</td>
                <td> {{ e.VeMarque }}</td>
                <td> {{ e.VeModele }}</td>
                <td> {{ e.VeConducteur.CoNom }}</td>

                <td class="center">
                    <a href="/vehicule/supprimer/{{ e.VeId }}">
                        <i class="fa-solid fa-trash-can"></i>
                    </a>
                </td>
                <td class="center">
                    <a href="/vehicule/modifier/{{ e.VeId }}">
                        <i class="fa-solid fa-pen-to-square"></i>
                    </a>
                </td>
               
            </tr>
        {% endfor %}
    </table>
 
    {% endif %}
 
    </section>
{% endblock %}