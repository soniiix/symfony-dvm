{% extends 'base.html.twig' %}
 
{% block main %}
    <section>
 
    <h2>Equipements</h2>
 
    <nav>
        <ul>
            <li><a href="/equipement/ajouter">[+] Ajouter</a></li>
            <li><a href="/equipement/supprimer_tout">[x] Tout Supprimer</a></li>
        </ul>
    </nav>
 
    {% if liste_equipements is empty %}
 
        <p>Aucun équipement trouvé.</p>
 
    {% else %}
 
    <table class="table">
        <tr>
            <th style="width: 50px">Id</th>
            <th style="width: 150px">Libellé</th>
            <th style="width: 150px">Prix</th>
            <th style="width: 50px">Suppr.</th>
            <th style="width: 50px">Mod.</th>
           
        </tr>
        {% for e in liste_equipements %}
            <tr>
                <td class="center">{{ e.EqId }}</td>
                <td> {{ e.EqLibelle }}</td>
                <td> {{ e.EqPrix }} €</td>

                <td class="center">
                    <a href="/equipement/supprimer/{{ e.EqId }}">
                        <img src="{{ asset('images/delete.png') }}" alt="delete">
                    </a>
                </td>
                <td class="center">
                    <a href="/equipement/modifier/{{ e.EqId }}">
                        <img src="{{ asset('images/modify.png') }}" alt="modify">
                    </a>
                </td>
               
            </tr>
        {% endfor %}
    </table>
 
    {% endif %}
 
    </section>
{% endblock %}