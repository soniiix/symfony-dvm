{% extends 'base.html.twig' %}
 
{% block main %}
    <section>
 
    <h2>Equipements</h2>

    <div class="actionButtons">
        <a href="/equipement/ajouter">Ajouter &nbsp;<i class="fa-solid fa-square-plus"></i></a>
        <a href="/equipement/supprimer_tout">Tout Supprimer &nbsp;<i class="fa-solid fa-square-xmark"></i></a>
    </div>
 
    {% if liste_equipements is empty %}
 
        <p>Aucun équipement trouvé.</p>
 
    {% else %}
 
    <table class="table">
        <tr>
            <th style="width: 50px">Id</th>
            <th style="width: 150px">Libellé</th>
            <th style="width: 150px">Prix</th>
            <th style="width: 50px">Supprimer</th>
            <th style="width: 50px">Modifier</th>
           
        </tr>
        {% for e in liste_equipements %}
            <tr>
                <td class="center">{{ e.EqId }}</td>
                <td> {{ e.EqLibelle }}</td>
                <td> {{ e.EqPrix }} €</td>

                <td class="center">
                    <a href="/equipement/supprimer/{{ e.EqId }}">
                        <i class="fa-solid fa-trash-can"></i>
                    </a>
                </td>
                <td class="center">
                    <a href="/equipement/modifier/{{ e.EqId }}">
                        <i class="fa-solid fa-pen-to-square"></i>
                    </a>
                </td>
               
            </tr>
        {% endfor %}
    </table>
 
    {% endif %}
 
    </section>
{% endblock %}