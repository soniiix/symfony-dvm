<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="{{ asset('css/style.css') }}" />
    <title>{% block title %}DVM{% endblock %}</title>
  </head>
  <body>

    <div class="cover"></div>
    <div class="menu">
      <ul>
        <li><a href="/">Accueil</a></li>
        <li><a href="/conducteur/lister">Conducteurs</a></li>
        <li><a href="/vehicule/lister">Véhicules</a></li>
        <li><a href="/equipement/lister">Équipements</a></li>
      </ul>
    </div>

    <!-- Navbar avec menu Hamburger -->
    <nav>
      <div class="ham-menu" onclick="toggleMenu()">
        <span></span>
        <span></span>
        <span></span>
      </div>
    </nav>

    <!-- Contenu principal -->
    <main>
      {% block main %}
      <section class="content">
        <header class="header">
          <h1 class="title">Département des Véhicules à Moteur</h1>
          <p class="description">Bienvenue sur notre site où nous gérons tous les véhicules ainsi que leurs conducteurs.</p>
        </header>

        <section class="info">
          <h2>Informations Importantes</h2>
          <p>Un conducteur peut détenir plusieurs véhicules.</p>
          <p>Un véhicule peut posséder plusieurs équipements.</p>
          <p>Les équipements peuvent être partagés entre plusieurs véhicules.</p>
        </section>
      </section>
      {% endblock %}
    </main>
    <script src="{{ asset('js/javascript.js') }}"></script>
  </body>
</html>
