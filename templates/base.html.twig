<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}DVM{% endblock %}</title>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
        <link rel="stylesheet" href="{{ asset('css/style.css') }}">
       
        {% block javascripts %}
            <script src="{{ asset('js/javascript.js') }}"></script>
        {% endblock %}
    </head>
    <body>
        <header>
            <video autoplay loop muted class="background-video">
                <source src="{{ asset('images/carf.mp4') }}" type="video/mp4">
                <source src="{{ asset('images/carf.webm') }}" type="video/webm">
                Votre navigateur ne prend pas en charge la vidéo HTML5.
            </video>
            <div class="voile"></div>
            <svg id="mySvg" width="1350" height="150">
                    <g>
                        <text id="animatedText" x="50%" y="50%" text-anchor="middle" dy="10" font-size="60" font-family="Arial, sans-serif" fill="white">
                            <animate attributeName="stroke-dasharray" values="450 0 0 450" dur="4s" repeatCount="indefinite" />
                            {{ svg_text | default('DÉPARTEMENT DES VÉHICULES À MOTEUR') }}
                        </text>
                    </g>
            </svg>
            <h1>Département des Véhicules à Moteur</h1>
        </header>
 
        <nav>
            <!-- Menu Hamburger -->
            <div class="menu-toggle" onclick="toggleMenu()">
                <div class="bar"></div>
                <div class="bar"></div>
                <div class="bar"></div>
            </div>
            <ul id="menu">
                <li><a href="/">Accueil</a></li>
                <li><a href="/conducteur/lister">Conducteurs</a></li>
                <li><a href="/vehicule/lister">Véhicules</a></li>
                <li><a href="/equipement/lister">Équipements</a></li>
                <!-- pas utile pour le moment
                <li><a href="/connexion">Connexion</a></li>
                -->           
            </ul>
        </nav>

        <main>
        {% block main %}
            <section class="fade-in">
                <h2>Bienvenue sur le site DVM !</h2>
 
                <p>Nous gérons tous les véhicules ainsi que leurs conducteurs.</p>
 
                <p>Un conducteur peut détenir plusieurs véhicules.</p>
 
                <p>Un véhicule possède 0 à plusieurs équipements et un équipement peut
                appartenir à 0 ou plusieurs véhicules.</p>
 
            </section>
        {% endblock %}
        </main>
 
        <footer>
            <p>Copyright 2024 by Jean-Michel Richer</p>
        </footer>
 
    </body>
</html>
