{% extends 'base.html.twig' %}

{% block title %}DVM - Modification d'un Conducteur{% endblock %}

{% block main %}
    <section class="form-section">
        <h2>Ajout d'un Conducteur</h2>
        
        <div class="form-container">
            {{ form_start(form) }}
                <div class="form-group">
                    {{ form_label(form.co_nom, 'Nom du conducteur') }}
                    {{ form_widget(form.co_nom) }}
                    <div class="form-errors">
                        {{ form_errors(form.co_nom) }}
                    </div>
                </div>

                <button type="submit" class="btn-submit">Mettre à jour</button>
            {{ form_end(form) }}
        </div>
    </section>
{% endblock %}
