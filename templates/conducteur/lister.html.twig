{% extends 'base.html.twig' %}
 
{% block main %}
    <section>
 
    <h2>Conducteurs</h2>
 
    <nav>
        <ul>
            <li><a href="/conducteur/ajouter">[+] Ajouter</a></li>
            <li><a href="/conducteur/supprimer_tout">[x] Tout Supprimer</a></li>
        </ul>
    </nav>
 
    {% if liste_conducteurs is empty %}
 
        <p>Aucun conducteur trouvé.</p>
 
    {% else %}

    <!-- Barre de recherche -->
    <input type="text" id="searchDriver" placeholder="Rechercher..."></input>
 
    <table class="table">
        <tr>
           
            <th style="width: 50px">Id</th>
            <th style="width: 250px">Nom</th>
            <th style="width: 50px">Suppr.</th>
            <th style="width: 50px">Mod.</th>
            <th style="width: 50px">Véhic.</th>
 
        </tr>
        {% for e in liste_conducteurs %}
            <tr class="driverRow">
               
                <td class="center"> {{ e.CoId }} </td>
                <td class="driverName"> {{ e.CoNom }} </td>
 
                <td class="center">
                    <a href="/conducteur/supprimer/{{ e.CoId }}">
                        <img src="{{ asset('images/delete.png') }}" alt="delete">
                    </a>
                </td>
                <td class="center">
                    <a href="/conducteur/modifier/{{ e.CoId }}">
                        <img src="{{ asset('images/modify.png') }}" alt="modify">
                    </a>
                </td>
                <td class="center">
                    <a href="/conducteur/voir/{{ e.CoId }}">
                        <img src="{{ asset('images/car_icon.png') }}" alt="see">
                    </a>
                </td>
               
            </tr>
        {% endfor %}
    </table>
 
    {% endif %}
 
    </section>
{% endblock %}