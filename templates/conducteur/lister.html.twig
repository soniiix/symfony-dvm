{% extends 'base.html.twig' %}
 
{% block main %}
    <section>
 
    <h2>Conducteurs</h2>

    <div class="actionButtons">
        <a href="/conducteur/ajouter">Ajouter &nbsp;<i class="fa-solid fa-square-plus"></i></a>
        <a href="/conducteur/supprimer_tout">Tout Supprimer &nbsp;<i class="fa-solid fa-square-xmark"></i></a>
    </div>
 
    {% if liste_conducteurs is empty %}
 
        <p>Aucun conducteur trouvé.</p>
 
    {% else %}

    <!-- Barre de recherche -->
    <input type="text" id="searchDriver" placeholder="Rechercher..."></input>
 
    <table class="table">
        <tr>
           
            <th style="width: 50px">Id</th>
            <th style="width: 250px">Nom</th>
            <th style="width: 50px">Supprimer</th>
            <th style="width: 50px">Modifier</th>
            <th style="width: 50px">Véhicules</th>
 
        </tr>
        {% for e in liste_conducteurs %}
            <tr class="driverRow">
               
                <td class="center"> {{ e.CoId }} </td>
                <td class="driverName"> {{ e.CoNom }} </td>
 
                <td class="center">
                    <a href="/conducteur/supprimer/{{ e.CoId }}">
                        <i class="fa-solid fa-trash-can"></i>
                    </a>
                </td>
                <td class="center">
                    <a href="/conducteur/modifier/{{ e.CoId }}">
                        <i class="fa-solid fa-pen-to-square"></i>
                    </a>
                </td>
                <td class="center">
                    <a href="/conducteur/voir/{{ e.CoId }}">
                        <i class="fa-solid fa-car"></i>
                    </a>
                </td>
               
            </tr>
        {% endfor %}
    </table>
 
    {% endif %}
 
    </section>
{% endblock %}