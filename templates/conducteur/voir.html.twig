{% extends 'base.html.twig' %}
 
{% block main %}
    <section>
 
    <h2>Conducteur : {{conducteur.CoNom}}</h2>


    <h3 id="title">
        Liste des véhicules
    <h3>

    {% if vehicules is empty %}
 
        <p>Ce conducteur n'a aucun véhicule.</p>
 
    {% else %}
 
    <table class="table">
        <tr>
            <th style="width: 50px">Id</th>
            <th style="width: 150px">Marque</th>
            <th style="width: 150px">Modèle</th>
            <th style="width: 50px">Suppr.</th>
            <th style="width: 50px">Mod.</th>
            <th style="width: 50px">Détails</th>
            <th style="width: 50px">Prix total équipements</th>
        </tr>
        {% for v in vehicules %}
            <tr>
               
                <td class="center">{{ v.vehicule.VeId }}</td>
                <td> {{ v.vehicule.VeMarque }}</td>
                <td> {{ v.vehicule.VeModele }}</td>

                <td class="center">
                    <a href="/vehicule/supprimer/{{ v.vehicule.VeId }}">
                        <img src="{{ asset('images/delete.png') }}" alt="delete">
                    </a>
                </td>
                <td class="center">
                    <a href="/vehicule/modifier/{{ v.vehicule.VeId }}">
                        <img src="{{ asset('images/modify.png') }}" alt="modify">
                    </a>
                </td>
                <td class="center">
                    <a href="/vehicule/voir/{{ v.vehicule.VeId }}">
                        <img class="eye" src="{{ asset('images/view.png') }}" alt="see" >
                    </a>
                </td>
                <td>{{v.totalEquipements}} €</td>
               
            </tr>
        {% endfor %}
    </table>
 
    {% endif %}





    </section>
{% endblock %}